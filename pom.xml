<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>com.example.pact</groupId>
  <artifactId>pact-contract-demo</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>

  <name>pact-contract-demo</name>
  <description>Didactic demo of consumer-driven contract testing with Pact (pact-jvm) and Spring Boot</description>

  <!--
    Module order matters: consumers first (they generate the pacts into target/pacts
    and convert them into the shared folder <root>/pacts), then the provider
    (instrument-service) which verifies those contracts.
  -->
  <modules>
    <module>consumer-trading</module>
    <module>consumer-settlement</module>
    <module>instrument-service</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <pact-jvm.version>4.6.21</pact-jvm.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Pact JVM 4.6.x: every module must use the same version -->
      <dependency>
        <groupId>au.com.dius.pact</groupId>
        <artifactId>consumer</artifactId>
        <version>${pact-jvm.version}</version>
      </dependency>
      <dependency>
        <groupId>au.com.dius.pact.consumer</groupId>
        <artifactId>junit5</artifactId>
        <version>${pact-jvm.version}</version>
      </dependency>
      <dependency>
        <groupId>au.com.dius.pact</groupId>
        <artifactId>provider</artifactId>
        <version>${pact-jvm.version}</version>
      </dependency>
      <dependency>
        <groupId>au.com.dius.pact.provider</groupId>
        <artifactId>junit5</artifactId>
        <version>${pact-jvm.version}</version>
      </dependency>
      <dependency>
        <groupId>au.com.dius.pact.provider</groupId>
        <artifactId>junit5spring</artifactId>
        <version>${pact-jvm.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>
      <!--
        On the 'clean' phase it empties the shared folder <root>/pacts:
        pacts are artifacts generated by the consumer tests, not sources.
        (inherited=false: it must only run in the parent project, not in the modules)
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>3.2.0</version>
        <inherited>false</inherited>
        <executions>
          <execution>
            <id>clean-shared-pacts</id>
            <phase>clean</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <delete dir="${project.basedir}/pacts" failonerror="false"/>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
